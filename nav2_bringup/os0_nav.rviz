# RViz config for the OS0 + MOLA + Nav2 rolling-window stack.
#
# The stock nav2_default_view.rviz does not fit this robot: its main display is /map (nothing
# publishes one here -- rolling window, no static grid) and its RobotModel needs
# /robot_description, which this stack does not publish at all. The result is a correct-looking
# RViz showing an empty grid, which reads as "nav2 is broken" when nav2 is fine.
#
# This config shows only what actually exists. The robot's position is the local costmap's
# published FOOTPRINT polygon -- the real 0.72 x 0.50 m rectangle Nav2 plans with, which is more
# useful for judging clearance than a mesh would be.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 25; 28; 33
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 50; 55; 62
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.55
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.7
    - Class: rviz_default_plugins/Polygon
      Name: Robot footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 60; 220; 100
      Alpha: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (veto input)
      Enabled: true
      Topic:
        Value: /scan_nav
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (m): 0.05
      Style: Points
      Color: 255; 90; 90
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/PointCloud2
      Name: OS0 cloud (3D)
      Enabled: false
      Topic:
        Value: /ouster/points
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 90; 170; 255
      Line Width: 0.04
      Line Style: Lines
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Marker Scale: 0.6
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Target Frame: base_link
      Scale: 45
      Angle: 0
      X: 0
      Y: 0
  Value: true
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
